# 당번표 작업자(manage.py run_worker). 웹과 따로 도는 프로세스 하나가 1분마다 아래 일을 한다.
#   - 알림 발송(텔레그램·웹 푸시): 매분
#   - DB 백업: 하루 한 번 .env 의 DUTY_BACKUP_HOUR 시(기본 3시) 이후 → data/backups/db-YYYYMMDD.sqlite3,
#     DUTY_BACKUP_KEEP_DAYS 일(기본 30)보다 오래된 백업은 지운다
#   - 상태 점검: 5분마다 웹 응답·최근 백업·디스크를 보고, 바뀌면 관리자 텔레그램(관리 화면 → 알림 설정)
# 서버에 이 파일을 /etc/systemd/system/ 로 복사해서 쓴다(README "설치"). 설정값은 /opt/duty_generator/.env.

[Unit]
Description=당번표 작업자(알림·백업·상태 점검)
# 텔레그램·푸시를 보내므로 네트워크가 올라온 뒤에 시작한다
After=network-online.target
Wants=network-online.target

[Service]
# 웹과 같은 사용자. data/ 에 DB·백업·로그를 쓴다
User=duty
WorkingDirectory=/opt/duty_generator
# 한 번에 하나만 돈다(data/.alarms.lock). 손으로 하나 더 띄워도 잠금 때문에 기다리기만 한다.
ExecStart=/opt/duty_generator/.venv/bin/python manage.py run_worker
# 죽으면 5초 뒤 다시 띄운다
Restart=always
RestartSec=5
# 화면 출력은 journald 로: journalctl -u duty-worker
# 앱 로그는 data/logs/worker.log 에도 남는다(매분 "alarms tick:" 한 줄, 실패는 WARNING/ERROR)

[Install]
WantedBy=multi-user.target
