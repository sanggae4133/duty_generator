# 당번표 웹 서버(gunicorn). 서버에 이 파일을 /etc/systemd/system/ 로 복사해서 쓴다(docs/OPERATIONS.md "설치").
# 설정값은 이 파일이 아니라 /opt/duty_generator/.env 에 있다. 앱이 시작할 때 직접 읽는다.
# 고친 뒤에는: sudo cp deploy/*.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl restart duty-web

[Unit]
Description=당번표 웹(gunicorn)
# 네트워크가 올라온 뒤에 시작한다
After=network-online.target
Wants=network-online.target

[Service]
# 코드(/opt/duty_generator)는 root 소유라 읽기만 하고, 쓰는 곳은 data/ 하나(duty 소유)다
User=duty
# 이 폴더에서 실행해야 config·duty 를 찾는다(설치 없이 저장소에서 바로 돈다)
WorkingDirectory=/opt/duty_generator
# 127.0.0.1:8090 에만 연다. 바깥 공개는 Tailscale Funnel 이 맡는다(docs/OPERATIONS.md "외부 공개").
#   이 주소를 바꾸면 duty/services/health.py 의 WEB_URL(작업자의 웹 응답 점검)도 같이 바꾼다.
# --workers 1 --threads 4: 프로세스를 하나만 둔다. 로그 파일 data/logs/web.log 를 한 프로세스만 써야
#   자정마다 파일을 넘길 때 꼬이지 않는다. 사용자가 수십 명이라 스레드 4개로 충분하다.
# 접근 로그(--access-logfile)는 켜지 말 것: 캘린더 구독 주소(/calendar/<토큰>.ics)에 비밀 토큰이 들어 있다.
# 운영 서버는 항상 DEBUG 끔: 환경변수가 .env 보다 우선하므로 .env 에 실수로 DUTY_DEBUG=1 이 있어도 꺼진다
Environment=DUTY_DEBUG=0
ExecStart=/opt/duty_generator/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8090 --workers 1 --threads 4
# 죽으면 5초 뒤 다시 띄운다
Restart=always
RestartSec=5
# 화면 출력(stdout/stderr)은 journald 로 간다: journalctl -u duty-web
# 앱 로그는 data/logs/web.log 에도 남는다(자정마다 새 파일, .env 의 DUTY_LOG_KEEP_DAYS 일 보관)

[Install]
# 부팅하면 자동으로 켠다(sudo systemctl enable duty-web 했을 때)
WantedBy=multi-user.target
