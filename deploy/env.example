# 이 파일은 sh 로 source 되고 systemd EnvironmentFile 로도 읽힌다.
# 값에 따옴표, 공백, $, #, <> 를 넣지 말 것. 예시 값은 실제 값으로 바꿀 것.
DUTY_SECRET_KEY=change-me-50-random-chars
DUTY_API_TOKEN=change-me-long-random-token
DUTY_ADMIN_PATH=manage-x7k2q
DUTY_ALLOWED_HOSTS=duty.example.ts.net,127.0.0.1,localhost
DUTY_CSRF_ORIGINS=https://duty.example.ts.net
DUTY_DB_PATH=/var/lib/duty_generator/db.sqlite3
