# 이 파일은 sh 로 source 되고 systemd EnvironmentFile 로도 읽힌다.
# 값에 따옴표, 공백, $, #, <> 를 넣지 말 것. 예시 값은 실제 값으로 바꿀 것.
DUTY_SECRET_KEY=change-me-50-random-chars
DUTY_API_TOKEN=change-me-long-random-token
DUTY_ADMIN_PATH=manage-x7k2q
DUTY_ALLOWED_HOSTS=duty.example.ts.net,127.0.0.1,localhost
DUTY_CSRF_ORIGINS=https://duty.example.ts.net
DUTY_DB_PATH=/var/lib/duty_generator/db.sqlite3
# --- 개인 알림 (비우면 해당 채널은 꺼진다) ---
# 웹앱 전용 텔레그램 봇(duty_notifier 봇과 다른 봇). 사용자명은 @ 없이.
DUTY_TELEGRAM_BOT_TOKEN=
DUTY_TELEGRAM_BOT_USERNAME=
# 웹 푸시 VAPID 키: README 의 생성 명령으로 만든 값만 넣는다.
DUTY_VAPID_PUBLIC_KEY=
DUTY_VAPID_PRIVATE_KEY=
DUTY_VAPID_SUBJECT=mailto:admin@example.com
# 텔레그램 알림 본문의 절대 링크용
DUTY_SITE_URL=https://duty.example.ts.net
# 잠금 파일(선택, 기본은 DUTY_DB_PATH 와 같은 폴더). 바꾸면 duty 사용자가 쓸 수 있는 경로여야 한다(/opt/duty_generator 는 안 됨).
DUTY_ALARMS_LOCK=/var/lib/duty_generator/alarms.lock
DUTY_TELEGRAM_LOCK=/var/lib/duty_generator/telegram-updates.lock
