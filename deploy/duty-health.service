[Unit]
Description=duty_generator 상태 점검(문제 생기면 텔레그램)

[Service]
Type=oneshot
User=duty
WorkingDirectory=/opt/duty_generator
# 설정은 앱이 /opt/duty_generator/.env 를, 받는 사람(ops_chat_id)은 관리 화면 → 알림 설정을 읽는다
ExecStart=/opt/duty_generator/.venv/bin/python manage.py health
StandardOutput=append:/var/log/duty_generator/health.log
StandardError=append:/var/log/duty_generator/health.log
