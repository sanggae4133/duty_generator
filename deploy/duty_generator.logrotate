# /etc/logrotate.d/duty_generator 에 복사한다. 하루 한 번 돈다(시스템 logrotate 타이머).
/var/log/duty_generator/*.log {
    daily
    # 보관 일수: 이 숫자만 바꾸면 된다(오늘 것 + rotate 개)
    rotate 7
    # 하루 안에 이 크기를 넘었으면 그날 회전할 때 바로 넘긴다
    maxsize 50M
    compress
    delaycompress
    missingok
    notifempty
    # 서비스가 파일을 계속 열고 있으므로 복사 후 비운다(재시작 불필요)
    copytruncate
}
