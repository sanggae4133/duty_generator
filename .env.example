# duty_generator 설정 파일 견본.
# 저장소 루트에 .env 로 복사해서 값을 채운다(.env 는 git 에 올라가지 않는다).
#   개발 PC: cp .env.example .env   → 아래 "개발:" 값으로 바꾼다(.env 가 없어도 DUTY_DEBUG=1 만 주면 돌아간다)
#   서버:   sudo install -o root -g duty -m 640 .env.example /opt/duty_generator/.env   → "서버:" 값으로 바꾼다
#
# 형식: 한 줄에 KEY=VALUE. 빈 줄과 # 로 시작하는 줄은 무시한다. 값 앞뒤 공백은 지운다.
#       따옴표를 쓰지 않는다(따옴표도 값의 일부가 된다). 줄 끝 주석도 쓰지 않는다(값의 일부가 된다).
# 우선순위: 이미 있는 환경변수(예: DUTY_DEBUG=1 manage.py ...)가 이 파일보다 이긴다.
# 값을 바꾼 뒤: 서버는 sudo systemctl restart duty-generator duty-alarms, 개발 PC 는 runserver 를 다시 켠다.
# 텔레그램 봇 토큰·웹 푸시 키는 여기가 아니라 관리 화면 → 알림 설정에서 넣는다.

# 개발 모드. 1 이면 오류 화면에 상세 정보가 나오고 http 쿠키를 허용한다. 서버에서는 절대 1 로 두지 않는다.
#   개발: 1
#   서버: 0
DUTY_DEBUG=0

# 세션·CSRF 서명 키. 50자 정도의 무작위 문자열. 바꾸면 모두 다시 로그인해야 한다. 남에게 보이지 않게 한다.
#   만들기: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#   개발: 비워 두면 DUTY_DEBUG=1 일 때 개발용 키를 쓴다
#   서버: 위 명령으로 만든 값(필수, 비면 서버가 시작하지 않는다)
DUTY_SECRET_KEY=

# 이 서버를 부르는 호스트 이름(쉼표로 구분, 공백 없이). 상태 점검이 127.0.0.1 로 부르므로 서버에도 127.0.0.1 을 넣는다.
#   개발: 127.0.0.1,localhost (기본값)
#   서버: duty.example.ts.net,127.0.0.1,localhost
DUTY_ALLOWED_HOSTS=duty.example.ts.net,127.0.0.1,localhost

# HTTPS 로 들어오는 폼 전송을 허용할 출처(쉼표로 구분). Funnel 주소를 https:// 를 붙여 넣는다.
#   개발: 비움
#   서버: https://duty.example.ts.net
DUTY_CSRF_ORIGINS=https://duty.example.ts.net

# 외부에서 보이는 사이트 주소. 경로 없이 https://호스트[:포트] 만. 텔레그램 알림 링크·캘린더 구독 주소에 쓴다.
# 비우면 알림 링크를 생략하고 캘린더 구독 주소를 만들 수 없다. 형식이 틀리면 서버가 시작하지 않는다.
#   개발: 비움 (또는 http://127.0.0.1:8000 — http 는 DUTY_DEBUG=1 일 때만 허용)
#   서버: https://duty.example.ts.net
DUTY_SITE_URL=https://duty.example.ts.net

# SQLite DB 파일 경로. 이 폴더에 잠금 파일(.alarms.lock 등)도 생긴다. 서비스 사용자(duty)가 쓸 수 있는 폴더여야 한다.
#   개발: 비움 (저장소 루트의 db.sqlite3)
#   서버: /var/lib/duty_generator/db.sqlite3
DUTY_DB_PATH=/var/lib/duty_generator/db.sqlite3

# Django 관리 화면 주소(/<값>/). 남이 짐작하기 어려운 값으로 바꾼다. 비울 수 없다.
#   개발: admin (기본값)
#   서버: manage-x7k2q 처럼 아무 글자
DUTY_ADMIN_PATH=manage-x7k2q

# --- 선택: 잠금 파일 위치 (보통 비워 둔다 = DB 와 같은 폴더) ---
# 바꾸면 duty 사용자가 쓸 수 있는 경로여야 한다(/opt/duty_generator 는 안 된다).
# run_alarms 를 하나만 돌게 하는 잠금
# DUTY_ALARMS_LOCK=/var/lib/duty_generator/.alarms.lock
# [연결 확인]이 텔레그램 getUpdates 를 한 번에 하나만 부르게 하는 잠금
# DUTY_TELEGRAM_LOCK=/var/lib/duty_generator/.telegram-updates.lock
