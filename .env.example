# duty_generator 설정 파일 견본. 개발 PC 와 서버의 차이는 전부 이 파일의 값으로만 정한다.
# 저장소 루트에 .env 로 복사해서 값을 채운다(.env 는 git 에 올라가지 않는다).
#   개발 PC: cp .env.example .env   → 각 항목의 "개발:" 값으로
#   서버:   sudo install -o root -g duty -m 640 .env.example .env   → 각 항목의 "서버:" 값으로
#
# 형식: 한 줄에 KEY=VALUE. 빈 줄과 # 로 시작하는 줄은 무시한다. 값 앞뒤 공백은 지운다.
#       따옴표를 쓰지 않는다(따옴표도 값의 일부가 된다). 줄 끝 주석도 쓰지 않는다(값의 일부가 된다).
#       값을 비우면(KEY=) 기본값을 쓴다.
# 우선순위: 이미 있는 환경변수(예: DUTY_DEBUG=1 .venv/bin/python manage.py ...)가 이 파일보다 이긴다.
# 값을 바꾼 뒤: 서버는 sudo systemctl restart duty-web duty-worker, 개발 PC 는 runserver 를 다시 켠다.
# 텔레그램 봇 토큰·웹 푸시 키·장애 알림 chat_id 는 여기가 아니라 관리 화면 → 알림 설정에서 넣는다.

# 개발 모드. 1 이면 오류 화면에 상세 정보가 나오고 http 쿠키를 허용한다. 서버에서는 절대 1 로 두지 않는다.
#   개발: 1
#   서버: 0 (기본값)
DUTY_DEBUG=0

# 세션·CSRF 서명 키. 50자 정도의 무작위 문자열. 바꾸면 모두 다시 로그인해야 한다. 남에게 보이지 않게 한다.
#   만들기: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#   개발: 비움 (DUTY_DEBUG=1 이면 개발용 키를 쓴다)
#   서버: 위 명령으로 만든 값(필수, 비면 서버가 시작하지 않는다)
DUTY_SECRET_KEY=

# 이 서버를 부르는 호스트 이름(쉼표로 구분, 공백 없이). 작업자의 상태 점검이 127.0.0.1 로 부르므로 서버에도 127.0.0.1 을 넣는다.
#   개발: 127.0.0.1,localhost (기본값)
#   서버: duty.example.ts.net,127.0.0.1,localhost
DUTY_ALLOWED_HOSTS=duty.example.ts.net,127.0.0.1,localhost

# HTTPS 로 들어오는 폼 전송을 허용할 출처(쉼표로 구분). Funnel 주소에 https:// 를 붙여 넣는다.
#   개발: 비움
#   서버: https://duty.example.ts.net
DUTY_CSRF_ORIGINS=https://duty.example.ts.net

# 외부에서 보이는 사이트 주소. 경로 없이 https://호스트[:포트] 만. 텔레그램 알림 링크·캘린더 구독 주소에 쓴다.
# 비우면 알림 링크를 생략하고 캘린더 구독 주소를 만들 수 없다. 형식이 틀리면 서버가 시작하지 않는다.
#   개발: 비움 (또는 http://127.0.0.1:8000 — http 는 DUTY_DEBUG=1 일 때만 허용)
#   서버: https://duty.example.ts.net
DUTY_SITE_URL=https://duty.example.ts.net

# Django 관리 화면 주소(/<값>/). 서버에서는 남이 짐작하기 어려운 값으로 바꾼다. 비우면 admin.
#   개발: 비움 (admin)
#   서버: manage-x7k2q 처럼 아무 글자
DUTY_ADMIN_PATH=manage-x7k2q

# 실행 중 생기는 파일을 두는 폴더 하나: DB(db.sqlite3), 백업(backups/), 로그(logs/), 잠금 파일.
# 상대 경로는 저장소 루트 기준. 없으면 만든다. 서비스 사용자(duty)가 쓸 수 있어야 한다.
#   개발: 비움 (저장소 루트의 data/)
#   서버: 비움 (/opt/duty_generator/data — 설치 때 duty 소유로 만든다)
DUTY_DATA_DIR=

# 매일 DB 를 백업하는 시각(0~23시, 서버 시간대와 상관없이 한국 시간). 작업자(run_worker)가 data/backups/db-YYYYMMDD.sqlite3 로 만든다.
#   개발·서버: 비움 (3)
DUTY_BACKUP_HOUR=

# 백업 보관 일수. 이보다 오래된 db-*.sqlite3 는 매일 백업 뒤 지운다(before-restore-* 는 지우지 않는다).
#   개발·서버: 비움 (30)
DUTY_BACKUP_KEEP_DAYS=

# 로그(data/logs/web.log, worker.log) 보관 일수. 자정마다 새 파일로 넘기고 이보다 오래된 파일은 지운다.
#   개발·서버: 비움 (14)
DUTY_LOG_KEEP_DAYS=
